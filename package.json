{
  "name": "nuxt-ui-forms",
  "version": "0.0.0",
  "description": "Library-agnostic form components for Nuxt UI with pluggable form engine adapters",
  "license": "MIT",
  "repository": "https://github.com/genu/nuxt-ui-forms.git",
  "packageManager": "pnpm@10.29.2",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build && pnpm client:build",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare client",
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../client && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@formwerk/core": "^0.14.4",
    "@nuxt/ui": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "@formwerk/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/devtools-kit": "4.0.0",
    "@nuxt/kit": "4.6.3",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@formwerk/core": "0.14.4",
    "@nuxt/devtools": "4.0.0",
    "@nuxt/eslint-config": "1.15.1",
    "@nuxt/module-builder": "1.0.2",
    "@nuxt/schema": "4.6.3",
    "@nuxt/test-utils": "4.0.0",
    "@nuxt/ui": "4.12.0",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "happy-dom": "21.0.4",
    "nuxt": "4.6.3",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-tsc": "3.2.4",
    "zod": "4.6.7"
  }
}
